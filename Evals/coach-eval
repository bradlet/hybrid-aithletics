#!/usr/bin/env bash
# Builds (release, incrementally) and runs the CoachEval CLI from any directory.
#   ./coach-eval list
#   ./coach-eval run --scenario record-yesterday --samples 3
# Release matters: a debug build generates several times slower.
set -euo pipefail
cd "$(dirname "$0")"
exec swift run --quiet -c release CoachEval "$@"
